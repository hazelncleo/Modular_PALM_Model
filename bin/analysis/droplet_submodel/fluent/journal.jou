	; Switch back commands because fluent is fucking stupid
	/file/set-batch-options yes yes no
	/mesh/adapt/set/method/hanging-node
	/file/convert-hanging-nodes-during-read?/no

	; Hook droplet sizing
	/define/user-defined/function-hooks execute-at-end "multithreaded_droplet_sizes_runtime::vof_droplet_sizing" ""

